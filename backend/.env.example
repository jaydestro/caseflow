PORT=4000

# ─────────────────────────────────────────────────────────────────────────────
# Cosmos DB connection
#
# Pick ONE of the three options below. Shared settings:
COSMOS_DATABASE=caseflow
COSMOS_CONTAINER=entities
# Provisioned RU/s on the container (used by the diagnostics page for budget %).
CONTAINER_RUS=10000

# ── Option 1: Local Cosmos DB emulator (default for dev) ─────────────────────
# Uses the emulator's well-known endpoint + key. The app trusts the emulator's
# self-signed cert automatically when the endpoint points at localhost/127.0.0.1.
COSMOS_ENDPOINT=https://localhost:8081
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_CONNECTION_STRING=
COSMOS_USE_ENTRA=false

# ── Option 2: Remote Cosmos DB account with an account key ───────────────────
# Comment out Option 1 and set your account's endpoint + primary/secondary key.
# (Or instead set COSMOS_CONNECTION_STRING and leave COSMOS_ENDPOINT/KEY blank.)
# COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
# COSMOS_KEY=<your-account-primary-or-secondary-key>
# COSMOS_CONNECTION_STRING=
# COSMOS_USE_ENTRA=false

# ── Option 3: Remote Cosmos DB with Entra ID (keyless, recommended) ──────────
# Set COSMOS_USE_ENTRA=true to authenticate via DefaultAzureCredential instead
# of a key. Leave COSMOS_KEY / COSMOS_CONNECTION_STRING blank. The signed-in
# identity (az login locally, or a managed identity in Azure) needs the Cosmos DB
# Built-in Data Contributor role on the account. See scripts/setup-cosmos-rbac.*.
# COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
# COSMOS_KEY=
# COSMOS_CONNECTION_STRING=
# COSMOS_USE_ENTRA=true

# ─────────────────────────────────────────────────────────────────────────────
# Azure resource metadata (optional) — used by the diagnostics page to build
# portal deep links and query Log Analytics. Leave blank if not needed.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
COSMOS_ACCOUNT_NAME=
# Log Analytics workspace GUID (customerId), not the ARM resource id.
LOG_ANALYTICS_WORKSPACE_ID=
LOG_ANALYTICS_WORKSPACE_NAME=
